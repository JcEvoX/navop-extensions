{
  "id": "clickhouse",
  "name": "ClickHouse",
  "description": "基于官方 clickhouse Rust 客户端(HTTP 接口,默认 8123 端口,可选 LZ4 压缩与 HTTPS)的 ClickHouse 列式数据库 IPC 驱动,支持连接管理、SQL 查询、库/表/视图/列/跳过索引/自定义函数元数据浏览、表设计与 DDL 构造。 IPC driver for ClickHouse built on the official clickhouse Rust client (HTTP interface, port 8123 by default, optional LZ4 compression and HTTPS), with connection management, SQL queries, database/table/view/column/skipping-index/function metadata browsing, table designer and DDL builders.",
  "version": "0.1.0",
  "engines": {
    "onetcli": ">=0.10.0"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/ClickHouse/ClickHouse",
  "homepage": "https://clickhouse.com",
  "authors": [
    "ClickHouse"
  ],
  "dependencies": {
    "clickhouse": "0.15.3"
  },
  "entry": {
    "command": "./clickhouse-ipc-driver",
    "args": [],
    "working_dir": null
  },
  "transport": {
    "name": "clickhouse-driver.sock",
    "connect_timeout_ms": 5000
  },
  "connection": {
    "single_file": false,
    "single_connection": false,
    "close_on_release": false,
    "path_fields": []
  },
  "methods": [
    "$/ping",
    "shutdown",
    "conn/test",
    "conn/open",
    "conn/close",
    "conn/ping",
    "conn/use",
    "query/start",
    "cursor/fetch",
    "cursor/close",
    "cursor/cancel",
    "exec/run",
    "exec/batch",
    "schema/object_view",
    "schema/databases",
    "schema/objects",
    "schema/columns",
    "schema/indexes",
    "schema/views",
    "schema/functions",
    "schema/dump_ddl",
    "ddl/build",
    "ddl/build_create_table",
    "ddl/build_alter_table",
    "ddl/build_drop"
  ],
  "dialect": {
    "identifier_quote_left": "`",
    "identifier_quote_right": "`",
    "limit_style": "limit_offset",
    "bool_true": "true",
    "bool_false": "false",
    "compatible_database_type": "ClickHouse"
  },
  "capabilities": {
    "supports_schema": false,
    "uses_schema_as_database": false,
    "supports_sequences": false,
    "supports_functions": true,
    "supports_procedures": false,
    "supports_triggers": false,
    "supports_table_engine": true,
    "supports_table_charset": false,
    "supports_table_collation": false,
    "supports_auto_increment": false,
    "supports_tablespace": false,
    "supports_unsigned": true,
    "supports_enum_values": false,
    "show_charset_in_column_detail": false,
    "show_collation_in_column_detail": false,
    "table_engines": [
      "MergeTree",
      "ReplacingMergeTree",
      "SummingMergeTree",
      "AggregatingMergeTree",
      "CollapsingMergeTree",
      "VersionedCollapsingMergeTree",
      "GraphiteMergeTree",
      "ReplicatedMergeTree",
      "Log",
      "TinyLog",
      "StripeLog",
      "Memory",
      "Distributed"
    ]
  },
